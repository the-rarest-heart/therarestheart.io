# Secrets — never commit these
.env
*.env
.env.*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
trh-agents/trh/          # virtual environment

# Data — videos/clips can be huge; keep out of git
trh-agents/data/videos/
trh-agents/data/clips/
trh-agents/data/transcripts/
trh-agents/data/covers/
trh-agents/data/packages/

# macOS
.DS_Store

# Logs
*.log
trh-agents/logs/

# Local Worker secrets — never commit. Wildcard because the exact pattern let
# .dev.vars.staging and .dev.vars.production straight through, and they hold
# the same kind of secret as the token. The example file stays committable.
.dev.vars*
!.dev.vars.example

# Your admin token, written locally for you to move into a password manager
admin-token.txt

# Database and media exports. These carry subscriber names and addresses, and
# this folder is a git repository, so one left in here could be pushed. The
# SOP writes them to ~/trh-backups instead; this is the backstop for when the
# command gets run in here anyway. Nothing here matches schema.sql.
*-backup.sql
commons-backup*.sql
commons-????-??-??.sql
/media-backup/
/trh-backups/

# Local dev state
.wrangler/
